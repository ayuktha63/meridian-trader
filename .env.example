# ─────────────────────────────────────────────────────────────
# Meridian — environment
# Copy to .env. Every value has a working default; nothing here
# is required to boot the platform.
# ─────────────────────────────────────────────────────────────

# ── Claude ────────────────────────────────────────────────────
# THIS FILE IS A TEMPLATE AND IS NEVER READ. Copy it to `.env`
# first — only `.env` is loaded:
#     cp .env.example .env
# Editing the key in here has no effect at all.
#
# A Claude Pro/Max subscription is NOT API access. The API is
# billed separately at console.anthropic.com → Billing. A key
# with no credits returns 400 invalid_request_error, and the
# platform falls back to its deterministic analyst.
#
# Without a key the platform still runs — the fallback analyst
# emits the identical JSON contract.
ANTHROPIC_API_KEY=
# claude-sonnet-5 | claude-opus-5 | claude-haiku-4-5
# Sonnet is the sensible default: roughly a fifth of Opus's cost
# per analysis, and this workload is structured evidence rather
# than open-ended reasoning.
CLAUDE_MODEL=claude-sonnet-5
# Thinking is on by default and max_tokens covers thinking +
# output — keep headroom.
CLAUDE_MAX_TOKENS=16000
# low | medium | high | xhigh | max — controls reasoning depth and spend.
CLAUDE_EFFORT=medium
# Seconds between automatic re-analyses of the active chart.
AI_AUTO_ANALYSIS_INTERVAL=45

# ── Market data ───────────────────────────────────────────────
# synthetic | coindcx | binance | twelvedata | zerodha
#   coindcx    – 17 real crypto pairs (USDT + INR), keyless  ← default
#   binance    – real BTCUSD/ETHUSD, keyless
#   twelvedata – real FX + XAUUSD, needs TWELVEDATA_API_KEY
#   synthetic  – session-aware simulated feed (no key, always works)
MARKET_PROVIDER=coindcx
TWELVEDATA_API_KEY=
# Crypto streams live regardless of the provider above.
HYBRID_CRYPTO_LIVE=true
# Ticks per second pushed per streaming symbol.
FEED_TICK_HZ=2
# Bars of history hydrated per timeframe at startup.
HISTORY_BARS=1500

# ── Storage ───────────────────────────────────────────────────
# Leave empty to use SQLite at backend/data/meridian.db
DATABASE_URL=
# e.g. postgresql+asyncpg://meridian:meridian@localhost:5432/meridian

# Leave empty for an in-process cache
REDIS_URL=
# e.g. redis://localhost:6379/0

# ── Server ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,app://.
LOG_LEVEL=INFO

# ── Risk defaults (used for lot sizing suggestions only) ──────
ACCOUNT_BALANCE=10000
RISK_PER_TRADE_PCT=1.0
ACCOUNT_CURRENCY=USD

# ── Angel One (live execution) ─────────────────────────────────
# TRADING_MODE=LIVE is the only thing that lets a real order reach a real
# broker. It defaults to PAPER and never switches itself. Even with LIVE set
# here, the UI still requires an explicit confirmation before the first
# live order — this only makes the *option* available.
TRADING_MODE=PAPER
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# ── Frontend (Vite) ───────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
