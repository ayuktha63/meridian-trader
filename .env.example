# ─────────────────────────────────────────────────────────────
# Meridian — environment
# Copy to .env. Every value has a working default; nothing here
# is required to boot the platform.
# ─────────────────────────────────────────────────────────────

# ── Claude ────────────────────────────────────────────────────
# THIS FILE IS A TEMPLATE AND IS NEVER READ. Copy it to `.env`
# first — only `.env` is loaded:
#     cp .env.example .env
# Editing the key in here has no effect at all.
#
# A Claude Pro/Max subscription is NOT API access. The API is
# billed separately at console.anthropic.com → Billing. A key
# with no credits returns 400 invalid_request_error, and the
# platform falls back to its deterministic analyst.
#
# Without a key the platform still runs — the fallback analyst
# emits the identical JSON contract.
ANTHROPIC_API_KEY=
# claude-sonnet-5 | claude-opus-5 | claude-haiku-4-5
# Sonnet is the sensible default: roughly a fifth of Opus's cost
# per analysis, and this workload is structured evidence rather
# than open-ended reasoning.
CLAUDE_MODEL=claude-sonnet-5
# Thinking is on by default and max_tokens covers thinking +
# output — keep headroom.
CLAUDE_MAX_TOKENS=16000
# low | medium | high | xhigh | max — controls reasoning depth and spend.
CLAUDE_EFFORT=medium
# Seconds between automatic re-analyses of the active chart.
AI_AUTO_ANALYSIS_INTERVAL=45

# ── Market data ───────────────────────────────────────────────
# synthetic | coindcx | binance | twelvedata | zerodha
#   coindcx    – 17 real crypto pairs (USDT + INR), keyless  ← default
#   binance    – real BTCUSD/ETHUSD, keyless
#   twelvedata – real FX + XAUUSD, needs TWELVEDATA_API_KEY
#   synthetic  – session-aware simulated feed (no key, always works)
MARKET_PROVIDER=coindcx
TWELVEDATA_API_KEY=
# Crypto streams live regardless of the provider above.
HYBRID_CRYPTO_LIVE=true
# Ticks per second pushed per streaming symbol.
FEED_TICK_HZ=2
# Bars of history hydrated per timeframe at startup.
HISTORY_BARS=1500

# ── Storage ───────────────────────────────────────────────────
# Leave empty to use SQLite at backend/data/meridian.db
DATABASE_URL=
# e.g. postgresql+asyncpg://meridian:meridian@localhost:5432/meridian

# Leave empty for an in-process cache
REDIS_URL=
# e.g. redis://localhost:6379/0

# ── Server ────────────────────────────────────────────────────
# Loopback only by default: this API can place real orders and has no login.
# With APP_ACCESS_TOKEN unset it answers this machine and nothing else — not
# the LAN, not a tunnel, not a web page in your own browser.
API_HOST=127.0.0.1
API_PORT=8000
# To reach it from another machine, set BOTH: a network API_HOST (0.0.0.0)
# and a long random token. The server will not start on a network address
# without one. The UI asks for the token once and keeps it in the browser.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ACCESS_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,app://.
LOG_LEVEL=INFO

# ── Risk defaults (used for lot sizing suggestions only) ──────
ACCOUNT_BALANCE=10000
RISK_PER_TRADE_PCT=1.0
ACCOUNT_CURRENCY=USD

# ── Angel One (live execution) ─────────────────────────────────
# TRADING_MODE=LIVE is the only thing that lets a real order reach a real
# broker. It defaults to PAPER and never switches itself. Even with LIVE set
# here, the UI still requires an explicit confirmation before the first
# live order — this only makes the *option* available.
TRADING_MODE=PAPER
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# ── Frontend (Vite) ───────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ── Auto-trader ───────────────────────────────────────────────
# Minimum reward-to-risk before the demo auto-trader enters. 2.0 is the
# value the backtest grid supported; lower it only knowingly.
MIN_RISK_REWARD=2.0

# ── Live risk limits (real orders only) ───────────────────────
# Hard limits, in the account's currency, read once at boot. They cannot be
# changed from the UI: to change one, edit this file and restart — which
# also returns you to PAPER. Set a limit to 0 to switch that check off.
LIVE_MAX_ORDER_VALUE=50000
LIVE_MAX_QUANTITY=5000
LIVE_MAX_OPEN_POSITIONS=2
LIVE_MAX_TRADES_PER_DAY=5
# Loss for the IST trading day at which the kill switch trips — after
# estimated brokerage and statutory charges, not on the fills alone. A new
# order is also refused if it, and every open stop, being hit would pass it.
LIVE_DAILY_LOSS_LIMIT=2000
LIVE_MAX_SYMBOL_EXPOSURE=50000
LIVE_MAX_SECTOR_EXPOSURE=100000
# Furthest an entry may be from the broker's last traded price, in percent.
LIVE_PRICE_BAND_PCT=1.0
LIVE_ENFORCE_MARKET_HOURS=true
# Cancel an entry order not filled within this many seconds.
LIVE_ENTRY_TIMEOUT_SECONDS=300

# Refuse a live order unless a recent walk-forward test showed an edge.
LIVE_REQUIRE_MEASURED_EDGE=true

# ── Alerts (optional) ─────────────────────────────────────────
# Warnings and critical alerts (stop not placed, daily loss limit, …) are
# also sent to this Telegram chat when both are set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# A live order never risks more than this share of the cash Angel One reports
# as available, whatever balance is typed into Settings.
LIVE_MAX_RISK_PCT_OF_FUNDS=1.0
# Orders are intraday. Open positions are closed this many minutes before the
# session ends, and no new entry is taken inside the longer window.
LIVE_SQUAREOFF_MINUTES_BEFORE_CLOSE=20
LIVE_NO_ENTRY_MINUTES_BEFORE_CLOSE=45
